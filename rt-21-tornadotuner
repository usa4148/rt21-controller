    {
        "id": "47bada2e9879d4c2",
        "type": "function",
        "z": "fa6a8c6129318283",
        "name": "Parse XML TXFreq",
        "func": "TXFreqRadio = msg.payload; // gets xml formatted message\nvar radionr = TXFreqRadio.RadioInfo.RadioNr;  // gets the radio number from the radioinfo msg\nvar freq=TXFreqRadio.RadioInfo.TXFreq;  // gets the tx frequency \nfreq = freq/100000;\nvar bandnum = 1;\n\n// Looks for 80 meter TX frequency on either radio\nif(radionr > 0) \n{                \nswitch(true)\n{\n    \n    case freq >= 3.5 && freq <= 3.99:\n    msg.payload = freq\n    return [msg];\n    \n} \n}\n\n\n/*\n<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<RadioInfo>\n    <app>N1MM</app>\n    <StationName>CW-80m</StationName>\n    <RadioNr>l</RadioNr>\n    <Freq>352211</Freq>\n    <TXFreq>352211</TXFreq>\n    <Mode>CW</Mode>\n    <OpCall>W1ABC</OpCall>\n    <IsRunning>False</IsRunning>\n    <FocusEntry>204626</FocusEntry>\n    <EntryWindowHwnd>\n    <Antenna>ll</Antenna>\n    <Rotors></Rotors>\n    <FocusRadioNr>l</FocusRadioNr>\n    <IsStereo>False</IsStereo>\n    <IsSplit>False</IsSplit>\n    <ActiveRadioNr>l</ActiveRadioNr>\n    <IsTransmitting>False</IsTransmitting>\n    <FunctionKeyCaption></FunctionKeyCaption>\n    <RadioName></RadioName>\n</RadioInfo>\nif( integer in range(0, 10 ) ) {\n\n}\nelse if ( integer in range( 11, 20 ) ) {\n\n\n\n}\nelse if ( integer in range( 21, 30 ) ) {\n\n\n\n}\n\nfunction range( min, max ){\nvar o = {}, i ;\n    for( i = min; i <= max; ++i ) {\n    o[i] = !0;\n    }\nreturn o;\n}\n*/",
