        "id": "8e3e25950b7fdf46",
        "type": "function",
        "z": "fa6a8c6129318283",
        "name": "Set 9500 Band Segment",
        "func": "var freq = msg.payload;\nvar bandsegment = 1;\n\n//var currbandseg = flow.get(\"bandsegmentcurrent\");\nswitch(true)\n{\n \n   \n    // 80 Meter Band Segmentts\n    case freq >= 3.5 && freq <= 3.55:\n    bandsegment = \"100\"\n    break;\n    case freq >= 3.55 && freq <= 3.65:\n    bandsegment = \"080\"\n    break;\n    case freq >= 3.65 && freq <= 3.75:\n    bandsegment = \"060\"\n    break;\n    case freq >= 3.75 && freq <= 3.85:\n    bandsegment = \"040\"\n    break;\n    case freq >= 3.85 && freq <= 4:\n    bandsegment = \"020\"\n    break;\n   \n}\n//if(currbandseg != bandsegment)\n//{\n\nmsg.payload = bandsegment;\nreturn msg;\n//}\n\n",
